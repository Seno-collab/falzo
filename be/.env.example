APP_NAME=falzo-api
APP_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true
# Optional extra sensitive log keys (comma-separated). Defaults are always applied.
# LOG_SENSITIVE_KEYS=pin,otp_code,session_id

HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=60s
# Trust X-Forwarded-For / X-Real-IP only when app is behind a trusted reverse proxy.
HTTP_TRUST_PROXY_HEADERS=false

AUTH_JWT_SECRET=change-me-in-production
AUTH_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=168h
AUTH_RATE_LIMIT_PER_MIN=60

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DATABASE=falzo
POSTGRES_USER=falzo
POSTGRES_PASSWORD=falzo
# Use `require` or stronger outside development.
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=25
POSTGRES_CONN_MAX_LIFETIME=5m

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
