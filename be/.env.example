SERVER_ENV=development
SERVER_PORT=8080
WEBSOCKET_ORIGIN_PATTERNS=localhost:3000,127.0.0.1:3000
GOOGLE_CLIENT_ID=


DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER_NAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=game_db
DATABASE_SSL_MODE=disable

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=portal:dev

REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5

REDIS_DIAL_TIMEOUT_SECONDS=5
REDIS_READ_TIMEOUT_SECONDS=3
REDIS_WRITE_TIMEOUT_SECONDS=3

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRED_MINUTES=15
JWT_REFRESH_EXPIRED_HOURS=168
JWT_RESET_EXPIRED_MINUTES=15

AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

GAME_MAX_PLAYERS_PER_ROOM=12
GAME_ROOM_TIMEOUT_SECONDS=3600
