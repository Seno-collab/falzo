APP_NAME=falzo-api
APP_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true
# Optional extra sensitive log keys (comma-separated). Defaults are always applied.
# LOG_SENSITIVE_KEYS=pin,otp_code,session_id
# Log JSON request/response bodies in HTTP access logs (recommended in development only).
LOG_HTTP_BODY_ENABLED=true
# Maximum bytes sampled from request/response body for logging.
LOG_HTTP_BODY_MAX_BYTES=4096
# Include source file, line, operation, and safe app metadata in API error responses.
# Keep false in public production.
ERROR_RESPONSE_DEBUG_ENABLED=false

HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=60s
# Trust X-Forwarded-For / X-Real-IP only when app is behind a trusted reverse proxy.
HTTP_TRUST_PROXY_HEADERS=false
# CORS settings (comma-separated values where applicable).
HTTP_CORS_ALLOWED_ORIGINS=*
HTTP_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
HTTP_CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,Origin,X-Requested-With
HTTP_CORS_ALLOW_CREDENTIALS=false
HTTP_CORS_MAX_AGE_SECONDS=600
HTTP_INTERNAL_HEADER_REQUIRED=false
HTTP_INTERNAL_HEADER_NAME=X-Falzo-Internal-Key
# Required outside development. Use at least 32 random characters.
HTTP_INTERNAL_HEADER_VALUE=

AUTH_JWT_SECRET=change-me-in-production
AUTH_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=168h
AUTH_RATE_LIMIT_PER_MIN=60
AUTH_DEPENDENCY_FAILURE_THRESHOLD=5
AUTH_DEPENDENCY_COOLDOWN=15s

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DATABASE=falzo
POSTGRES_USER=falzo
POSTGRES_PASSWORD=falzo
# Use `require` or stronger outside development.
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=25
POSTGRES_CONN_MAX_LIFETIME=5m

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

ENGAGEMENT_CLAIM_MIN_IDLE=30s
ENGAGEMENT_MAX_RETRIES=10

# API uses this URL to upload to SeaweedFS. In Docker Compose use http://seaweedfs:8888.
SEAWEEDFS_BASE_URL=http://127.0.0.1:8888
# Public URL saved in image records and returned to clients. Leave empty to use SEAWEEDFS_BASE_URL.
SEAWEEDFS_PUBLIC_URL=http://127.0.0.1:8888
SEAWEEDFS_TIMEOUT=10s
UPLOAD_MAX_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
